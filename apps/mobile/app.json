{
  "expo": {
    "name": "Baseline",
    "slug": "baseline",
    "scheme": "baseline",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.will123sykv.baseline",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.github.will123sykv.baseline",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Baseline reads your heart rate, HRV, sleep, steps, energy and weight to work out recovery, strain and calories burned.",
          "NSHealthUpdateUsageDescription": "Baseline saves the food and weight you log so Apple Health stays complete.",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
